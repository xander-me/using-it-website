---
const { pathname } = Astro.url;
const isHome = pathname === '/' || pathname === '';
const nav = [
  { href: '/blog/', label: 'Articles' },
  { href: '/tools/', label: 'Tools' },
  { href: '/licensing/', label: 'Licensing' },
  { href: '/about-me/', label: 'About' },
];
---
<header class="site-header">
  <div class="wrap-wide bar">
    <a class="wordmark" href="/"><span class="u">using-</span><span>IT</span></a>
    <nav class="site-nav" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} aria-current={pathname.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">◐</button>
  </div>
</header>
<script is:inline>
  (function () {
    var stored = localStorage.getItem('theme');
    if (stored) document.documentElement.setAttribute('data-theme', stored);
    var btn = document.getElementById('theme-toggle');
    if (btn) btn.addEventListener('click', function () {
      var el = document.documentElement;
      var dark = el.getAttribute('data-theme') === 'dark';
      el.setAttribute('data-theme', dark ? 'light' : 'dark');
      localStorage.setItem('theme', dark ? 'light' : 'dark');
    });
  })();
</script>