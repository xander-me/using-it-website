---
/** Honest, unobtrusive Microsoft licensing / CSP call-to-action.
 *  Destination: https://minelicenser.dk (CloudFactory as CSP). */
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<div class={compact ? 'licensing-cta' : 'licensing-cta'} style={compact ? 'margin: 0; padding: 16px 18px;' : undefined}>
  <div class="left">
    <div class="tile" style="background: var(--color-accent);">M365</div>
    <div>
      <b>Need Microsoft licenses? It takes two minutes.</b>
      <span class="small">Sign up as a customer at minelicenser.dk — quick, no commitments.</span>
    </div>
  </div>
  <a class="btn-primary" href="https://minelicenser.dk/" target="_blank" rel="noopener">minelicenser.dk →</a>
</div>