---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Article from '../layouts/Article.astro';

/** Root-level catch-all so migrated WordPress posts keep their EXACT original URLs
 *  (WP served posts at /slug/). WordPress pages (about-me, remote-support, youtube,
 *  tools-2) are served here as well. Static routes (/, /blog/, /tools/, /licensing/,
 *  /microsoft-licenses/, /blogposts/, /404) take precedence over this catch-all. */
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  const pages = (await getCollection('pages', ({ data }) => (import.meta.env.PROD ? !data.draft : true)))
    .filter((p) => p.id !== 'microsoft-licenses' && p.id !== 'tools');
  return [...posts, ...pages].map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description || d.title,
  datePublished: d.pubDate,
  ...(d.updatedDate ? { dateModified: d.updatedDate } : {}),
  author: { '@type': 'Person', name: 'Alexander Christensen', url: 'https://using-it.dk/about-me/' },
  publisher: { '@type': 'Organization', name: 'Using-IT', url: 'https://using-it.dk/' },
  mainEntityOfPage: d.original_url ?? new URL(Astro.url.pathname, Astro.site).toString(),
  ...(d.image ? { image: new URL(d.image, Astro.site).toString() } : {}),
  ...(d.categories?.length ? { articleSection: d.categories.join(', ') } : {}),
};
---
<Base
  title={`${d.title} · Using-IT`}
  description={d.description || d.title}
  image={d.image}
  type="article"
  jsonLd={jsonLd}
>
  <Article entry={entry} />
</Base>