---
import Base from '../layouts/Base.astro';
---
<Base title="404 — Using-IT">
  <div class="wrap" style="padding: 80px 0; text-align: center;">
    <div class="kicker">404</div>
    <h1 style="font-size:1.8rem; color:var(--color-text-strong); margin-bottom:12px;">That page does not exist (anymore)</h1>
    <p style="margin-bottom:20px;">The old WordPress site had many URLs. If you came from a bookmark, try the search or the article list.</p>
    <a class="btn-primary" href="/blog/">View all articles →</a>
  </div>
</Base>